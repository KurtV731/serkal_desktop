@echo off
setlocal EnableExtensions DisableDelayedExpansion
set "PIN=584120e71d088b77f988cc7677e6f1747f49b944"
set "SETUP=serkal-desktop-1-2-7-wartung-9-setup.exe"
set "SERKAL_CMD_FILE=%~f0"
set "BUILD=%LOCALAPPDATA%\SerKal-Build-wartung-9-%RANDOM%-%RANDOM%"
set "REPO=https://github.com/KurtV731/serkal_desktop.git"

echo SerKal Desktop 1.2.7-wartung.9 - privates Windows-Testsetup
set "STEP=Git, Node.js und npm finden"
where git.exe >nul 2>&1 || goto failed
where node.exe >nul 2>&1 || goto failed
where npm.cmd >nul 2>&1 || goto failed

set "STEP=Vorhandene Google-OAuth-Datei finden"
if not defined SERKAL_GOOGLE_OAUTH_FILE (
    for %%F in ("C:\ppd\serkal\serkal_dev\serkal_private\google_oauth_client.json" "C:\ppd\serkal\serkal_private\google_oauth_client.json" "%LOCALAPPDATA%\serkal_private\google_oauth_client.json" "C:\serkal_dev\serkal_private\google_oauth_client.json") do if not defined SERKAL_GOOGLE_OAUTH_FILE if exist "%%~fF" set "SERKAL_GOOGLE_OAUTH_FILE=%%~fF"
)
if not defined SERKAL_GOOGLE_OAUTH_FILE set /p "SERKAL_GOOGLE_OAUTH_FILE=Pfad zur vorhandenen google_oauth_client.json: "
set "SERKAL_GOOGLE_OAUTH_FILE=%SERKAL_GOOGLE_OAUTH_FILE:"=%"
if not defined SERKAL_GOOGLE_OAUTH_FILE goto failed
if not exist "%SERKAL_GOOGLE_OAUTH_FILE%" goto failed
for %%F in ("%SERKAL_GOOGLE_OAUTH_FILE%") do if /i not "%%~nxF"=="google_oauth_client.json" goto failed

set "STEP=Isolierten Bauordner anlegen"
mkdir "%BUILD%" || goto failed
pushd "%BUILD%" || goto failed
set "IN_BUILD=1"
set "STEP=Freigegebenen Quellcommit laden"
git init --quiet || goto failed
git fetch --no-tags --depth=1 "%REPO%" "%PIN%" || goto failed
git -c advice.detachedHead=false checkout --detach "%PIN%" || goto failed

set "STEP=Gepruefte Baukorrekturen anwenden"
node.exe -e "const fs=require('node:fs'); const rows=fs.readFileSync(process.env.SERKAL_CMD_FILE,'utf8').split(/\r?\n/); const patch=rows.filter(row=>row.startsWith('rem PATCH ')).map(row=>row.slice(10)).join(''); if(!patch) throw Error('Build patch missing'); fs.writeFileSync('installer3.patch',Buffer.from(patch,'base64'))" || goto failed
git apply --check installer3.patch || goto failed
git apply installer3.patch || goto failed
del installer3.patch || goto failed

set "STEP=Abhaengigkeiten und Tests"
set "ELECTRON_SKIP_BINARY_DOWNLOAD="
call npm.cmd ci || goto failed
call npm.cmd test || goto failed
set "STEP=Windows-Setup bauen"
if not exist "node_modules\electron\dist\electron.exe" node.exe "node_modules\electron\install.js" || goto failed
call npm.cmd run make -- --platform=win32 --arch=x64 || goto failed
set "STEP=Setup und SHA-256 neben die CMD kopieren"
if not exist "out\make\squirrel.windows\x64\%SETUP%" goto failed
certutil.exe -hashfile "out\make\squirrel.windows\x64\%SETUP%" SHA256 > "%BUILD%\setup.sha256.txt" || goto failed
copy /y "out\make\squirrel.windows\x64\%SETUP%" "%~dp0%SETUP%" >nul || goto failed
copy /y "%BUILD%\setup.sha256.txt" "%~dp0%SETUP%.sha256.txt" >nul || goto failed
popd
rd /s /q "%BUILD%"
echo(
echo Fertig. Setup neben dieser CMD:
echo "%~dp0%SETUP%"
if not defined SERKAL_BUILD_NO_PAUSE pause
exit /b 0

:failed
if defined IN_BUILD popd
echo(
echo Bau abgebrochen bei: %STEP%
if exist "%BUILD%\" echo Bauordner: "%BUILD%"
if not defined SERKAL_BUILD_NO_PAUSE pause
exit /b 1

